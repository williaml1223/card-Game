rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile Rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId);
      
      allow update: if isOwner(userId) && 
        incoming().diff(existing()).affectedKeys().hasAny([
          'credits', 'gold', 'materials', 'arenaScrolls', 'level', 'xp', 'rank', 'points', 
          'guildId', 'friendId', 'avatarUrl', 'ownedIcons', 'storeIcons', 'isAdmin', 'elo',
          'battlePassLevel', 'battlePassXp', 'claimedRewards'
        ]);

      // User Cards Rules
      match /cards/{cardId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId);
        
        allow update: if isOwner(userId) && 
          incoming().diff(existing()).affectedKeys().hasAny([
            'level', 'xp', 'activeSkinId', 'unlockedSkins', 'borderId', 'backgroundId'
          ]);
      }

      // Missions
      match /missions/{missionId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId) && 
          incoming().diff(existing()).affectedKeys().hasAny(['completed']);
      }
    }

    match /guilds/{guildId} {
      allow list, get: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }
  }
}
