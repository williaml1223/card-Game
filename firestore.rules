rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile Rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && 
        incoming().keys().hasAll(['uid', 'displayName', 'credits', 'gold', 'materials', 'arenaScrolls', 'level', 'xp', 'rank', 'points']) &&
        incoming().uid == userId &&
        incoming().credits == 2000 &&
        incoming().gold == 500 &&
        incoming().materials == 100 &&
        incoming().arenaScrolls == 0 &&
        incoming().level == 1 &&
        incoming().xp == 0 &&
        incoming().rank == 'BRONZE' &&
        incoming().points == 0;
      
      allow update: if isOwner(userId) && 
        incoming().diff(existing()).affectedKeys().hasAny(['credits', 'gold', 'materials', 'arenaScrolls', 'level', 'xp', 'rank', 'points', 'guildId']);

      // User Cards Rules
      match /cards/{cardId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && 
          incoming().keys().hasAll(['cardId', 'level', 'xp', 'ownerId']) &&
          incoming().ownerId == userId;
        
        allow update: if isOwner(userId) && 
          incoming().diff(existing()).affectedKeys().hasOnly(['level', 'xp']) && 
          incoming().ownerId == existing().ownerId;
      }

      // Missions
      match /missions/{missionId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId) && 
          incoming().diff(existing()).affectedKeys().hasOnly(['completed']);
      }
    }

    match /guilds/{guildId} {
      allow list, get: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }
  }
}
